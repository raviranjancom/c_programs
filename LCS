#include<bits/stdc++.h>
using namespace std;

int n,m;
vector<vector<int>> dp;
int solve(string &s1,string &s2,int i,int j){
    if(i==n || j==m) return 0;
    if(dp[i][j]!=-1) return dp[i][j];
    int x=0,y=0;
    if(s1[i]==s2[j]) x=1+solve(s1,s2,i+1,j+1);
    y=max(solve(s1,s2,i+1,j),solve(s1,s2,i,j+1));
    return dp[i][j]=max(x,y);
}
void print(){
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cout<<dp[i][j]<<" ";
        }
        cout<<endl;
    }
    return ;
}
int main(){
    string s1="abcde",s2="bdqek";
    n=s1.length();
    m=s2.length();
    dp.resize(n+1,vector<int>(m+1,-1));
    solve(s1,s2,0,0);
    string ans;
    for(int i=0,j=0;i<n && j<m;){
        cout<<i<<" "<<j<<endl;
        if(s1[i]==s2[j]){
            ans.push_back(s1[i]);
            i++; j++;
        }
        else if(i+1==n || j+1==m){
            if(i+1==n && j+1==m) break;
            else if(i+1==n) j=j+1;
            else if(j+1==m) i=i+1;
        }
        else if(dp[i+1][j]<=dp[i][j+1]){
            j=j+1;
        }
        else{
            i=i+1;
        }
    }
    cout<<"=>"<<ans<<endl;
    return 0;
}
